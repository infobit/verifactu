<openerp>
  <data>
    <record id="view_company_verifactu_form" model="ir.ui.view">
        <field name="name">res.company.verifactu.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="verifactu" string="veri*FACTU">
                    <group>
                       <field name="tax_agency_id"/>
                    </group>
                    <separator
                        name="aeat_verifactu_config"
                        string="AEAT veri*FACTU Configuration"
                    />
                    <group name="verifactu_enabled">
                        <field name="verifactu_enabled" />
                        <field name="verifactu_start_date" />
                    </group>
                    <group attrs="{'invisible': [('verifactu_enabled', '=', False)]}">
                        <group name="verifactu_config">
                            <field name="verifactu_test" />
                        </group>
                    </group>
                    <group attrs="{'invisible': [('verifactu_enabled', '=', False)]}">
                        <group name="verifactu_description">
                            <field name="verifactu_description" />
                        </group>
                    </group>
                    <group attrs="{'invisible': [('verifactu_enabled', '=', False)]}">
                        <group name="verifactu_developer_id">
                            <field name="verifactu_developer_id" />
                        </group>
                    </group>
                    <group attrs="{'invisible': [('verifactu_enabled', '=', False)]}">
                        <group name="verifactu_last_document_id">
                            <field name="verifactu_last_document_id" />
                            <field name="last_verifactu_invoice_entry_id"/>
                        </group>
                    </group>
                    <!--<group>
                       <group name="QR Invoice">
                         <field name="url_qrverifactu"/>
                         <field name="url_qrverifactu_test"/>
                         <field name="url_qrnoverifactu"/>
                         <field name="url_qrnoverifactu_test"/>
                       </group>
                    </group>-->
                    <group name="verifactu_connector" string="Connector config">
                            <field name="verifactu_use_connector" />
                            <field name="verifactu_send_mode"
                                   attrs="{'invisible': [('verifactu_use_connector', '=', False)]}"/>
                            <field name='verifactu_sent_time' widget='float_time'
                                   attrs="{'invisible': ['|', ('verifactu_use_connector', '=', False), ('verifactu_send_mode', '!=', 'fixed')]}"/>
                            <field name='verifactu_delay_time' widget='float_time'
                                   attrs="{'invisible': ['|', ('verifactu_use_connector', '=', False), ('verifactu_send_mode', '!=', 'delayed')]}"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
  </data>
</openerp>
