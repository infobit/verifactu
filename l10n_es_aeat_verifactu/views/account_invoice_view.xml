<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_invoice_from_ref" model="ir.ui.view">
            <field name="name">Invoice (hash)</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <button name="invoice_open" position="after">
                 <button
                    type="object"
                    string="Resend to Verifactu"
                    name="resend_verifactu"
                    groups="l10n_es_aeat.group_account_aeat"
                    attrs="{'invisible': ['|','|',('verifactu_enabled', '=', False), ('state', 'not in', ['open']), ('verifactu_state','in',['sent','cancelled'])]}"
                 />
                 <button
                    type="object"
                    string="Send cancellation to Verifactu"
                    name="cancel_verifactu"
                    groups="l10n_es_aeat.group_account_aeat"
                    attrs="{'invisible': ['|','|',('verifactu_enabled', '=', False), ('state', 'not in', ['cancel']), ('verifactu_state', 'not in', ['sent','sent_w_errors','sent_modified'])]}"
                 />
                 </button>
                 <notebook position="inside">
                    <page string="Veri*FACTU" name="group_aeat_verifactu">
                    <notebook>
                     <page name="page_aeat_result_general" string="Veri*FACTU Result" >
                          <group>
                             <field name="verifactu_state"/>
                             <field name="verifactu_csv"/>
                             <field name="verifactu_send_failed"/>
                             <field name="verifactu_send_error"/>
                            <!--attrs="{'invisible': [('verifactu_send_failed', '=', False)]}"-->
                          </group>
                          <group>
                            <field name="verifactu_invoice_entry_ids" />
                          </group>
                          <!--<group>
                            <label for="verifactu_response_line_ids" />
                          </group>
                          <field name="verifactu_response_line_ids" nolabel="1">
                                    <tree>
                                        <field name="create_date" />
                                        <field name="entry_id" />
                                        <field
                                            name="send_state"
                                        />
                                    </tree>
                          </field>-->
                     </page>
                     <page name="page_aeat_result_technical" string="Technical" groups="base.group_system">
                          <group>
                            <field name="verifactu_return"/>
                            <field name="verifactu_header_sent" />
                            <field name="verifactu_content_sent" />
                            <field name="verifactu_hash_string" />
                            <field name="verifactu_hash" />
                            <field name="verifactu_macrodata"/>
                            <field name="verifactu_qr_url"/>
                            <field name="qr_image"/>
                          </group>
                     </page>
                     <page string="Veri*FACTU Information" name="page_aeat"> <!--attrs="{'invisible': [('verifactu_enabled', '=', False)]}">-->
                      <group string="Veri*FACTU Information" name="group_aeat_information">
                        <field name="verifactu_enabled" invisible="0" readonly="1" />
                        <field name="verifactu_description" />
                        <field name="verifactu_tax_key" />
                        <field name="verifactu_registration_key" />
                        <field name="verifactu_registration_date" readonly="1" />
                        <field name="verifactu_refund_type" />
                        <field name="verifactu_refund_specific_invoice_type" />
                      </group>
                     </page>
                    </notebook>
                   </page>   
                </notebook>
            </field>
        </record>
        <!--
           <button name="button_hash" type="object" string="Generar Hash" class="oe_highlight"/>
                    <field name="restrict_mode_hash_table"/>
                    <field name="secure_sequence_number"/>
                    <field name="inalterable_hash"/>
                    <field name="string_to_hash"/>
        -->
        <record id="view_invoice_filter_verifactu" model="ir.ui.view">
            <field name="name">Invoice (filter verifactu)</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <!--<field name="partner_id" position="after">
                    <field name=""/>
                </field>-->
                <filter string="Partner" position="after">
                    <group string="Verifactu filters">
                    <separator />
                    <filter
                        name="verifactu_not_sent"
                        string="Verifactu not sent"
                        domain="[('verifactu_state', '=', 'not_sent'), ('verifactu_enabled', '=', True)]"
                        help="Never sent to Verifactu"
                    />
                    <filter
                        name="verifactu_pending"
                        string="With modifications not sent to Verifactu"
                        domain="[('verifactu_state', 'in', ['sent_modified','cancelled_modified'])]"
                        help="Already sent but with local changes not sent yet"
                    />
                    <filter
                        name="verifactu_sent"
                        string="Verifactu sent"
                        domain="[('verifactu_state', 'not in', ['not_sent'])]"
                        help="Already sent to Verifactu. It includes cancelled invoices"
                    />
                    <filter
                        name="aeat_send_failed"
                        string="Verifactu failed"
                        domain="[('verifactu_send_failed', '=', True)]"
                        help="The last attemp to sent to Verifactu has failed"
                    />
                    <separator />
                    <filter
                        name="verifactu_cancelled"
                        string="Verifactu cancelled"
                        domain="[('verifactu_state', 'in', ['cancelled','cancelled_modified'])]"
                        help="Cancelled invoices at Verifactu"
                    />
                    <separator />
                    <filter
                    string="Verifactu error"
                    name="verifactu_error"
                    domain="[('verifactu_send_failed', '=', True)]"
                    context="{'group_by':'verifactu_send_error'}"
                    />
                </group>
                </filter>
            </field>
        </record>
        <record id="view_invoice_wtree_verifactu" model="ir.ui.view">
            <field name="name">Invoice(verifactu)</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <!-- Añadimos el nuevo decoration -->
                    <attribute name="decoration-danger">verifactu_state in ['not_sent', 'sent_w_errors'] and verifactu_enabled and verifactu_hash_string</attribute>
                </xpath>
                <field name="state" position="after">
                    <field name="verifactu_state"/>
                    <field name="verifactu_enabled"/>
                    <field name="verifactu_hash_string" invisible="1"/>
                </field>
            </field>
        </record>

    </data>
</openerp>

