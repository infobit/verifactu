<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="verifactu_developer_form_view" model="ir.ui.view">
            <field name="name">verifactu.developer.form</field>
            <field name="model">verifactu.developer</field>
            <field name="arch" type="xml">
                <form string="Verifactu developer">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sif_name"/>
                            <field name="sif_id"/>
                            <field name="vat"/>
                        </group>
                        <group>
                            <field name="installation_number"/>
                            <field name="version"/>
                            <field name="responsibility_declaration"/>
                        </group>
                    </group>
                 </form>
            </field>
        </record>

        <record id="verifactu_developer_tree_view" model="ir.ui.view">
            <field name="name">verifactu.developer.tree</field>
            <field name="model">verifactu.developer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="sif_name"/>
                    <field name="sif_id"/>
                    <field name="vat"/>
                    <field name="installation_number"/>
                    <field name="version"/>
                    <field name="responsibility_declaration"/>
                 </tree>
            </field>
        </record>

        <record id="verifactu_developer_action" model="ir.actions.act_window">
            <field name="name">Developer VERIFACTU</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">verifactu.developer</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="verifactu_developer_menu" name="VERIFACTU Developer" action="verifactu_developer_action"
            parent="l10n_es_aeat_verifactu.certificate_verifactu_parent_menu" sequence="0"/>

    </data>
</odoo>
